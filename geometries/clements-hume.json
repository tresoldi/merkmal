  "metadata_features": {
    "consonant": "human-readable duplicate of the derived `consonantal`, which is what scores",
    "vowel": "human-readable duplicate of the derived `vocoid`, which is what scores",
    "tonal-autosegment": "marks a token that is a tone and nothing else, as CLTS writes it; carried for the caller's benefit and deliberately not scored, because a tone and a segment are not comparable on a shared scale",
    "diphthong": "structural: this grapheme is a vowel cluster. Clusters score through their components, not through this label",
    "triphthong": "structural: a three-vowel cluster; see `diphthong`",
    "complex": "structural: a segment written as more than one letter",
    "geminate": "structural: the components are identical",
    "consonant-cluster": "structural: this grapheme is a consonant cluster; see `diphthong`"
  },
  "metadata_feature_prefixes": {
    "n1-": "structural: a feature of the cluster's first component, reported so a caller can see the parse. Components are scored individually by the cluster path in system.c; this copy of the label does not score",
    "n2-": "structural: a feature of the second component; see `n1-`",
    "n3-": "structural: a feature of the third component; see `n1-`",
    "move-": "structural: the trajectory between components of a vowel cluster. Descriptive only: no dimension reads it, and the movement is not scored"
  },
  "cluster_policy": {
    "nucleus_share": 0.7,
    "offglide_share": 0.3,
    "length_penalty": 0.15,
    "component_share": 0.8,
    "segment_share": 0.2,
    "note": "How a segment written as more than one part -- a diphthong, an untied affricate, a geminate -- is scored against something else. Stipulated, like the node weights they sit on top of, and data for the same reason `tier_policy` is: these five numbers move every diphthong, triphthong and geminate distance in the three categorical systems, so changing one should be a reviewable diff rather than a tree edit. Against a plain segment the first part carries `nucleus_share` and the rest are averaged into `offglide_share`. `length_penalty` is charged per part the other side lacks, and is waived when one side is a geminate and the other carries a length feature -- that waiver is a rule and lives in src/cluster.c, because it reads both segments. The final score is `component_share` of the part-by-part agreement plus `segment_share` of the cluster scored as one segment."
  },
  "tier_policy": {
    "cross_tier_cost": 1.0,
    "note": "What a tone costs against a segment. Data rather than a tree edit, so it can be changed, versioned and argued about without touching the geometry that scores everything else -- and so a later evidence-derived or preference-derived scorer can carry its own without moving this one. 1.0 means incomparable: gold alignments never put a tone in a column with a segment, and the alignment sweep in bench/sweep_tone_distance.py saturates above about 0.7, meaning the data cannot distinguish any cost in that region from refusing to compare at all. A caller who wants a finite cost reads the comparability flag and supplies their own. Scoring it through the geometry instead yields 0.61 against a stop and 0.50 against a vowel, which are artifacts of how many features the other segment has rather than statements about tone, and are below the threshold at which an aligner stops matching tone to segments."
  }
}
