# Resolve the prefix from the installed file so --prefix installs remain usable.
prefix=${pcfiledir}/@MERKMAL_PC_PREFIX_FROM_PCFILEDIR@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: merkmal
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmerkmal
Libs.private: @MERKMAL_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
